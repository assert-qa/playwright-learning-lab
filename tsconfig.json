{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "strict": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noImplicitAny": false
  },
    "include": ["src/**/*", "tests/**/*.ts", "data/**/*.ts", "playwright.config.ts"],
    "exclude": ["node_modules", "dist"]
}